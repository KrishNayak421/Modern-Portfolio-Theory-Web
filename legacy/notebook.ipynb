        "    daily_mean = daily_returns.mean()\n",
        "    annualized = daily_mean * 252\n",
        "\n",
        "    result = {}\n",
        "    for stock in annualized.index:\n",
        "        result[str(stock)] = round(float(annualized[stock]) * 100, 2)\n",
        "\n",
        "    stocks = [str(s) for s in annualized.index.tolist()]\n",
        "    return result, stocks\n"
