    "# Service: returns.py\n",
    "This service computes annualized returns from daily returns."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2ad8da75",
   "metadata": {},
   "source": [
    "## Function: compute_annualized_returns\n",
    "Annualized return is the mean daily return times 252 (trading days), expressed as a percentage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "45bd4cc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_annualized_returns(daily_returns: pd.DataFrame) -> dict:\n",
    "    \"\"\"\n",
    "    Calculate annualized returns from daily returns.\n",
    "    Returns a dict mapping stock ticker to annualized return (as percentage).\n",
    "    \"\"\"\n",
    "    daily_mean = daily_returns.mean()\n",
    "    annualized = daily_mean * 252\n",
    "\n",
    "    result = {}\n",
    "    for stock in annualized.index:\n",
    "        result[str(stock)] = round(float(annualized[stock]) * 100, 2)\n",
    "\n",
    "    stocks = [str(s) for s in annualized.index.tolist()]\n",
    "    return result, stocks"
   ]
  },
