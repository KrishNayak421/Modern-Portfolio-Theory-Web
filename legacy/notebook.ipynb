    "tickers = [\"AAPL\", \"MSFT\", \"GOOGL\", \"AMZN\"]\n",
    "start_date = \"2022-01-01\"\n",
    "end_date = \"2025-01-01\"\n",
    "benchmark_ticker = \"^GSPC\"\n",
    "risk_free_rate = 0.0\n",
